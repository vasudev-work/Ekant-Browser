<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aekant" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="barColor">@color/surface</item>
        <item name="mutedColor">@color/text_secondary</item>
    </style>

    <style name="Theme.Aekant.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_surface</item>
        <item name="android:navigationBarColor">@color/light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="barColor">@color/light_surface</item>
        <item name="mutedColor">@color/light_muted</item>
    </style>
</resources>
