<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext HTTP: the platform refuses it, in addition to the app's own upgrade. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
