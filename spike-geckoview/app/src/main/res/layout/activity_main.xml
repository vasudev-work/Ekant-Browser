<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B21"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/url"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#1E242C"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#F2F4F7"
            android:textColorHint="#9BA3AE"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B21"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#9BA3AE"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="#F26A1B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161B21">

        <ImageButton android:id="@+id/btn_back"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@android:drawable/ic_media_previous" android:tint="#F2F4F7" />
        <ImageButton android:id="@+id/btn_fwd"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_forward"
            android:src="@android:drawable/ic_media_next" android:tint="#F2F4F7" />
        <ImageButton android:id="@+id/btn_reload"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_reload"
            android:src="@android:drawable/ic_menu_rotate" android:tint="#F2F4F7" />
        <ImageButton android:id="@+id/btn_home"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_home"
            android:src="@android:drawable/ic_menu_myplaces" android:tint="#F2F4F7" />
        <ImageButton android:id="@+id/btn_tabs"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_tabs"
            android:src="@android:drawable/ic_menu_recent_history" android:tint="#F2F4F7" />
        <TextView android:id="@+id/tab_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="22dp" android:gravity="center"
            android:text="1" android:textColor="#F26A1B" android:textStyle="bold" />
        <ImageButton android:id="@+id/btn_menu"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_menu"
            android:src="@android:drawable/ic_menu_more" android:tint="#F2F4F7" />
    </LinearLayout>

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
